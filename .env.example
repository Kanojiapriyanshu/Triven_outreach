# Copy this to .env and fill in real values — never commit .env

# Neon PostgreSQL – get from neon.tech dashboard
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.neon.tech/neondb?sslmode=require&channel_binding=require"
DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require"

# Auth – run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-32-char-random-hex"

# Google OAuth – from console.cloud.google.com
GOOGLE_CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxx"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/gmail/callback"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Neon S3 object storage
AWS_ENDPOINT_URL_S3="https://xxxx.storage.neon.tech"
AWS_ACCESS_KEY_ID="nak_live_xxxx"
AWS_SECRET_ACCESS_KEY="nsk_live_xxxx"
AWS_REGION="us-east-2"
S3_BUCKET_NAME="triven-crm-uploads"
