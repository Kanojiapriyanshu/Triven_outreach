# Copy this to .env and fill in real values — never commit .env

# Neon PostgreSQL – get from neon.tech dashboard
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.neon.tech/neondb?sslmode=require&channel_binding=require"
DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require"

# Auth – run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-32-char-random-hex"

# Google OAuth – from console.cloud.google.com
GOOGLE_CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxx"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/gmail/callback"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Neon S3 object storage
AWS_ENDPOINT_URL_S3="https://xxxx.storage.neon.tech"
AWS_ACCESS_KEY_ID="nak_live_xxxx"
AWS_SECRET_ACCESS_KEY="nsk_live_xxxx"
AWS_REGION="us-east-2"
S3_BUCKET_NAME="triven-crm-uploads"

# ─── YouTube audience (Audience → Discover / Prospects) ─────────────────────
# Required: Google Cloud → APIs & Services → enable "YouTube Data API v3" → Credentials → API key
YOUTUBE_API_KEY=""
# Optional: your project's daily quota if Google raised it (default 10000)
# YOUTUBE_DAILY_QUOTA=10000

# ─── Keys in general ────────────────────────────────────────────────────────
# Any key below may hold SEVERAL keys separated by commas: KEY=first,second,third
# Calls go to the least-used key; a key that runs out is paused until it resets and the next
# one (then the next provider) takes over. Usage per key is shown on System Health.
# Free-plan limits are built in. On a paid plan raise them with <NAME>_MONTHLY_CAP or
# <NAME>_DAILY_CAP (0 = no limit), e.g. TOMBA_MONTHLY_CAP=1000

# Email verification: set ANY of these to get mailbox-level VERIFIED results. All that are set
# are used, in this order: Reoon, ZeroBounce, MillionVerifier, NeverBounce.
# Without one, emails are only domain-checked (MX) and stay "unknown".
# ZEROBOUNCE_API_KEY=""
# NEVERBOUNCE_API_KEY=""
# MILLIONVERIFIER_API_KEY=""
# REOON_API_KEY=""
# EMAIL_VERIFIER="MILLIONVERIFIER"   # only needed if you set more than one (incl. HUNTER)

# Optional: AI review of shortlisted commenters + a one-line personal opener
# ANTHROPIC_API_KEY=""
# AUDIENCE_AI_MODEL="claude-opus-5"   # e.g. claude-haiku-4-5 for lower cost

# Identity search: finds the website / LinkedIn of high-intent commenters (pick one)
# BRAVE_SEARCH_API_KEY=""            # https://brave.com/search/api/
# SERPER_API_KEY=""                  # https://serper.dev

# Email finders: business email once we know who someone is and where they work
# HUNTER_API_KEY=""                  # free plan: ~50 credits/month; set EMAIL_VERIFIER=HUNTER to also verify with it
# APOLLO_API_KEY=""
# Tried one after another until one finds the address: Hunter, Apollo, Prospeo, Tomba.
# PROSPEO_API_KEY=""
# Tomba needs its key and secret together, joined by a colon: ta_xxxx:ts_xxxx
# TOMBA_API_KEY=""

# ─── Lead Finder (Prospecting → Lead Finder: local businesses → emails) ─────
# Optional: Google Places API (New). Google Cloud → enable "Places API (New)" → Credentials → API key
# (restrict it to that API). A billing account must be attached, but the free monthly allowance
# (~1,000 Text Search calls with ratings/hours, 20 businesses each) is never exceeded: the app stops
# at the cap set in Lead Finder → Rules. Without a key, OpenStreetMap is used (free, no key).
# GOOGLE_PLACES_API_KEY=""
# More business sources, each with its own data (the same business from two sources is merged):
#   Foursquare Places: website, phone, often an email. 10,000 free searches a month.
#   TomTom Search: website and phone. 2,500 free searches a day.
# FOURSQUARE_API_KEY=""
# TOMTOM_API_KEY=""
# Always on, no key: the NPI Registry (every US dentist, chiropractor, optometrist… with phone
# and official contact) and OpenStreetMap.
# Serper / Brave above also power the "email published elsewhere" and owner-name lookups,
# and a verifier key above lets it confirm guessed addresses (owner@, info@, office@).

# ─── Meetings (Pipeline) ────────────────────────────────────────────────────
# Optional: Cal.com or Calendly webhook → POST {APP_URL}/api/webhooks/calendar
# Use the same value as the webhook's signing secret in Cal.com / Calendly.
# CALENDAR_WEBHOOK_SECRET=""
