// Triven CRM – Prisma Schema
// Database: Neon PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─────────────────────────────────────────────────────────────────────────────
// AUTH
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("SALES") // ADMIN | SALES | VIEWER
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  leads      Lead[]
  activities Activity[]

  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// SENDER ACCOUNTS (Gmail OAuth)
// ─────────────────────────────────────────────────────────────────────────────

model SenderAccount {
  id               String    @id @default(cuid())
  displayName      String
  email            String    @unique
  gmailStatus      String    @default("NOT_CONNECTED") // NOT_CONNECTED | CONNECTED | ERROR | EXPIRED
  accessToken      String?   @db.Text
  refreshToken     String?   @db.Text
  tokenExpiresAt   DateTime?
  dailyEmailTarget Int       @default(20)
  isActive         Boolean   @default(true)
  signature        String?   @db.Text
  timezone         String    @default("America/New_York")
  // Auto-paused after repeated bounces (deliverability guard); null = sending normally
  pausedUntil      DateTime?
  pauseReason      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  leads                  Lead[]
  campaignSenderAccounts CampaignSenderAccount[]
  activities             Activity[]
  followUpTasks          FollowUpTask[]

  @@map("sender_accounts")
}

// ─────────────────────────────────────────────────────────────────────────────
// CAMPAIGNS
// ─────────────────────────────────────────────────────────────────────────────

model Campaign {
  id              String    @id @default(cuid())
  name            String
  industry        String
  targetCountry   String?
  targetLocation  String?
  product         String?
  description     String?   @db.Text
  timezone        String    @default("America/New_York")
  // Follow-up schedule: days after first email
  followUpDay1    Int       @default(1)
  followUpDay2    Int       @default(2)
  followUpDay3    Int       @default(3)
  isActive        Boolean   @default(true)
  isPaused        Boolean   @default(false)
  // Auto-sending (Instantly-style): only ACTIVE campaigns email their queued leads
  sendingStatus   String    @default("DRAFT") // DRAFT | ACTIVE | PAUSED
  dailyNewLeads   Int       @default(30) // max first emails per day for this campaign
  launchedAt      DateTime?
  // Campaign schedule (null = use the global Settings): window in the Settings timezone,
  // send days ("1,2,3,4,5" = Mon–Fri) and the gap between emails as inboxes take turns
  windowStart     String?
  windowEnd       String?
  sendDays        String?
  gapMinMinutes   Int?
  gapMaxMinutes   Int?
  // Audience intelligence
  useCase         String? // use-case campaign (AI_RECEPTIONIST, VOICE_AGENT …); null = niche/persona campaign
  segmentId       String? // audience segment that feeds this campaign
  launchCheckedAt DateTime? // 20 sample emails reviewed before launch
  autoPush        Boolean   @default(false) // READY prospects routed here are added automatically
  recipientHours  Boolean   @default(false) // first emails only in the recipient's local business hours
  abTest          Boolean   @default(false) // alternate first-email variants A/B
  pausedReason    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  leads          Lead[]
  senderAccounts CampaignSenderAccount[]
  templates      EmailTemplate[]

  @@map("campaigns")
}

model CampaignSenderAccount {
  campaignId      String
  senderAccountId String

  campaign      Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  senderAccount SenderAccount @relation(fields: [senderAccountId], references: [id], onDelete: Cascade)

  @@id([campaignId, senderAccountId])
  @@map("campaign_sender_accounts")
}

// ─────────────────────────────────────────────────────────────────────────────
// LEADS
// ─────────────────────────────────────────────────────────────────────────────

model Lead {
  id String @id @default(cuid())

  // Basic info
  firstName    String?
  lastName     String?
  fullName     String?
  jobTitle     String?
  companyName  String
  website      String?
  companyEmail String?
  phone        String?
  linkedIn     String?
  country      String?
  state        String?
  city         String?
  industry     String?
  subIndustry  String?
  companySize  String?
  notes        String? @db.Text

  // Sales info
  campaignId      String?
  leadSource      String    @default("MANUAL") // MANUAL|IMPORT|REFERRAL|WEBSITE|LINKEDIN|COLD_OUTREACH|OTHER
  status          String    @default("NEW")
  stage           String?
  priority        String    @default("MEDIUM") // LOW|MEDIUM|HIGH|URGENT
  score           Int       @default(0)
  assignedUserId  String?
  senderAccountId String?
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?
  lastResponseAt  DateTime?

  // Research
  personalizationNotes String? @db.Text
  companyPainPoint     String? @db.Text
  whyThisLead          String? @db.Text
  researchSummary      String? @db.Text
  websiteNotes         String? @db.Text
  socialMediaNotes     String? @db.Text
  relevantService      String?
  prospectingNotes     String? @db.Text

  // Outreach
  firstEmailSubject String?
  firstEmailBody    String?   @db.Text
  firstEmailSentAt  DateTime?
  followUp1Subject  String?
  followUp1Body     String?   @db.Text
  followUp1SentAt   DateTime?
  followUp2Subject  String?
  followUp2Body     String?   @db.Text
  followUp2SentAt   DateTime?
  followUp3Subject  String?
  followUp3Body     String?   @db.Text
  followUp3SentAt   DateTime?

  // Conversion
  hasReplied    Boolean   @default(false)
  isInterested  Boolean   @default(false)
  demoSent      Boolean   @default(false)
  demoDate      DateTime?
  meetingBooked Boolean   @default(false)
  meetingDate   DateTime?
  proposalSent  Boolean   @default(false)
  hasSale       Boolean   @default(false)
  saleDate      DateTime?
  dealValue     Decimal?  @db.Decimal(12, 2)
  lostReason    String?

  // Audience source (YouTube prospects pushed into a campaign): why this person was contacted
  prospectId       String? @unique
  sourcePlatform   String?
  sourceChannel    String?
  sourceVideo      String?
  sourceVideoUrl   String?
  sourceComment    String? @db.Text
  commentTopic     String?
  interestCategory String?
  persona          String?

  // Lead Finder source (local business found on Google Maps / OpenStreetMap)
  businessId String? @unique

  // Intelligence + attribution
  useCase          String?
  replyCategory    String? // INTERESTED | MEETING | QUESTION | NOT_NOW | NOT_INTERESTED | UNSUBSCRIBE | OUT_OF_OFFICE | REFERRAL | BOUNCE | OTHER
  replySuggestion  String? @db.Text
  firstContainerId String? // channel the person was first found on
  firstContentId   String? // video / thread / article
  templateVariant  String? // A/B variant of the first email

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prospect      Prospect?      @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  business      Business?      @relation(fields: [businessId], references: [id], onDelete: SetNull)
  campaign      Campaign?      @relation(fields: [campaignId], references: [id])
  assignedUser  User?          @relation(fields: [assignedUserId], references: [id])
  senderAccount SenderAccount? @relation(fields: [senderAccountId], references: [id])
  activities    Activity[]
  followUpTasks FollowUpTask[]
  emailMessages EmailMessage[]

  @@index([companyEmail])
  @@index([companyName])
  @@index([senderAccountId])
  @@index([campaignId])
  @@index([status])
  @@index([nextFollowUpAt])
  @@index([linkedIn])
  @@map("leads")
}

// ─────────────────────────────────────────────────────────────────────────────
// EMAIL TEMPLATES
// ─────────────────────────────────────────────────────────────────────────────

model EmailTemplate {
  id         String  @id @default(cuid())
  name       String
  subject    String
  body       String  @db.Text
  type       String // FIRST_EMAIL|FOLLOW_UP_1|FOLLOW_UP_2|FOLLOW_UP_3|OTHER
  campaignId String?
  isDefault  Boolean @default(false)
  variant    String? // "B" = the alternative first email in an A/B test

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign Campaign? @relation(fields: [campaignId], references: [id])

  @@map("email_templates")
}

// ─────────────────────────────────────────────────────────────────────────────
// FOLLOW-UP TASKS
// ─────────────────────────────────────────────────────────────────────────────

model FollowUpTask {
  id              String    @id @default(cuid())
  leadId          String
  senderAccountId String?
  type            String // FOLLOW_UP_1|FOLLOW_UP_2|FOLLOW_UP_3
  subject         String?
  body            String?   @db.Text
  scheduledAt     DateTime
  status          String    @default("PENDING") // PENDING|SENT|SKIPPED|CANCELLED
  sentAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  lead          Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  senderAccount SenderAccount? @relation(fields: [senderAccountId], references: [id])

  @@index([leadId])
  @@index([scheduledAt])
  @@index([status])
  @@map("follow_up_tasks")
}

// ─────────────────────────────────────────────────────────────────────────────
// ACTIVITIES (timeline)
// ─────────────────────────────────────────────────────────────────────────────

model Activity {
  id              String   @id @default(cuid())
  leadId          String
  userId          String?
  senderAccountId String?
  type            String // EMAIL_SENT|FOLLOW_UP_SENT|EMAIL_OPENED|EMAIL_REPLIED|CALL|DEMO_SENT|MEETING_BOOKED|STATUS_CHANGED|NOTE_ADDED|TASK_CREATED|SALE|OTHER
  title           String
  body            String?  @db.Text
  metadata        Json?
  createdAt       DateTime @default(now())

  lead          Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user          User?          @relation(fields: [userId], references: [id])
  senderAccount SenderAccount? @relation(fields: [senderAccountId], references: [id])

  @@index([leadId])
  @@index([createdAt])
  @@map("activities")
}

// ─────────────────────────────────────────────────────────────────────────────
// EMAIL MESSAGES (Gmail thread sync)
// ─────────────────────────────────────────────────────────────────────────────

model EmailMessage {
  id             String    @id @default(cuid())
  leadId         String
  gmailMessageId String?   @unique
  gmailThreadId  String?
  direction      String // OUTBOUND|INBOUND
  subject        String?
  body           String?   @db.Text
  fromAddress    String?
  toAddress      String?
  sentAt         DateTime?
  receivedAt     DateTime?
  isRead         Boolean   @default(false)
  createdAt      DateTime  @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([gmailThreadId])
  @@map("email_messages")
}

// ─────────────────────────────────────────────────────────────────────────────
// SUPPRESSION LIST
// ─────────────────────────────────────────────────────────────────────────────

model SuppressionEntry {
  id      String   @id @default(cuid())
  email   String?  @unique
  domain  String?
  reason  String? // UNSUBSCRIBED|BOUNCED|INVALID|DO_NOT_CONTACT|SPAM_COMPLAINT
  addedAt DateTime @default(now())

  @@index([email])
  @@index([domain])
  @@map("suppression_list")
}

// ─────────────────────────────────────────────────────────────────────────────
// IMPORTS
// ─────────────────────────────────────────────────────────────────────────────

model Import {
  id            String   @id @default(cuid())
  fileName      String
  fileType      String // CSV|XLSX
  totalRows     Int      @default(0)
  validRows     Int      @default(0)
  importedRows  Int      @default(0)
  duplicateRows Int      @default(0)
  errorRows     Int      @default(0)
  status        String   @default("PENDING") // PENDING|VALIDATING|READY|IMPORTING|COMPLETED|FAILED
  columnMapping Json?
  errors        Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rows ImportRow[]

  @@map("imports")
}

model ImportRow {
  id        String   @id @default(cuid())
  importId  String
  rowNumber Int
  rawData   Json
  status    String   @default("PENDING") // PENDING|VALID|DUPLICATE|ERROR|IMPORTED|SKIPPED
  errorMsg  String?
  leadId    String?
  createdAt DateTime @default(now())

  import Import @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId])
  @@index([status])
  @@map("import_rows")
}

// ─────────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  type      String // REPLY|FOLLOW_UP_DUE|FOLLOW_UP_OVERDUE|MEETING|DEMO|IMPORT_DONE|IMPORT_ERROR|GMAIL_ERROR
  title     String
  body      String?
  isRead    Boolean  @default(false)
  leadId    String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// SETTINGS
// ─────────────────────────────────────────────────────────────────────────────

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ─────────────────────────────────────────────────────────────────────────────
// AUDIENCE DISCOVERY (YouTube → commenters → verified prospects)
// ─────────────────────────────────────────────────────────────────────────────

// A YouTube channel whose audience we mine (e.g. an AI-automation creator)
model AudienceChannel {
  id               String    @id @default(cuid())
  youtubeChannelId String    @unique
  platform         String    @default("YOUTUBE") // YOUTUBE | HN
  title            String
  handle           String?
  description      String?   @db.Text
  thumbnailUrl     String?
  country          String?
  subscriberCount  Int       @default(0)
  videoCount       Int       @default(0)
  viewCount        BigInt    @default(0)
  uploadsPlaylist  String?
  topicScore       Int       @default(0) // how on-topic the channel is for Triven (0-100)
  isTracked        Boolean   @default(true)
  lastScannedAt    DateTime?
  notes            String?   @db.Text
  yieldScore       Float     @default(0) // QRA per 1,000 comments (blended with meetings once known)
  qualityFlagged   Float     @default(0) // share of comments flagged as coordinated / inauthentic (0-1)
  autoPaused       Boolean   @default(false)
  pausedReason     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  videos AudienceVideo[]

  @@map("audience_channels")
}

model AudienceVideo {
  id                String    @id @default(cuid())
  youtubeVideoId    String    @unique
  platform          String    @default("YOUTUBE") // external id "hn:<story id>" for Hacker News
  url               String?
  channelId         String
  title             String
  description       String?   @db.Text
  thumbnailUrl      String?
  publishedAt       DateTime?
  durationSeconds   Int       @default(0)
  language          String?
  viewCount         Int       @default(0)
  likeCount         Int       @default(0)
  commentCount      Int       @default(0)
  score             Int       @default(0) // audience-fit score (0-100)
  scoreReasons      String?   @db.Text
  interestCategory  String? // topic of the video → default interest of its commenters
  status            String    @default("DISCOVERED") // DISCOVERED | QUEUED | COLLECTING | DONE | SKIPPED | ERROR
  commentsCollected Int       @default(0)
  maxComments       Int       @default(2000)
  nextPageToken     String?
  lastError         String?
  lastCollectedAt   DateTime?
  fastLaneUntil     DateTime? // fresh upload from a top source: re-collected daily until then
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  channel  AudienceChannel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  comments AudienceComment[]

  @@index([channelId])
  @@index([status])
  @@map("audience_videos")
}

// One public comment. youtubeCommentId makes collection idempotent (never processed twice)
model AudienceComment {
  id                 String    @id @default(cuid())
  youtubeCommentId   String    @unique
  videoId            String
  prospectId         String?
  authorChannelId    String?
  authorName         String
  text               String    @db.Text
  likeCount          Int       @default(0)
  replyCount         Int       @default(0)
  isReply            Boolean   @default(false)
  parentCommentId    String?
  publishedAt        DateTime?
  language           String?
  relevance          String    @default("LOW") // HIGH | MEDIUM | LOW | SPAM
  score              Int       @default(0)
  persona            String?
  interestCategory   String?
  topic              String? // "building voice agents for clinics"
  signals            String[]  @default([])
  classifiedBy       String    @default("RULES") // RULES | AI
  flaggedInauthentic Boolean   @default(false) // coordinated / incentivised engagement: no weight in scoring
  flagReason         String?
  createdAt          DateTime  @default(now())

  video    AudienceVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  prospect Prospect?     @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([videoId])
  @@index([prospectId])
  @@index([relevance])
  @@map("audience_comments")
}

// A person, keyed by their YouTube channel id: commenting on 5 videos is still one prospect
model Prospect {
  id                  String    @id @default(cuid())
  platform            String    @default("YOUTUBE") // YOUTUBE | HN (external id "hn:<username>")
  profileUrl          String?
  youtubeChannelId    String    @unique
  displayName         String
  firstName           String?
  lastName            String?
  handle              String?
  avatarUrl           String?
  channelDescription  String?   @db.Text
  subscriberCount     Int       @default(0)
  videoCount          Int       @default(0)
  country             String?
  countrySource       String? // CHANNEL | HUNTER | LOCATION | LINKEDIN | PHONE | TEXT | CURRENCY | DOMAIN | MANUAL
  countryConfidence   Int       @default(0)
  region              String? // AMERICAS | EUROPE | MIDDLE_EAST_AFRICA | ASIA_PACIFIC
  company             String?
  jobTitle            String?
  website             String?
  linkedIn            String?
  twitter             String?
  github              String?
  otherLinks          String[]  @default([])
  location            String?
  bio                 String?   @db.Text
  persona             String? // FOUNDER | AGENCY | CONSULTANT | DEVELOPER | BUSINESS_OWNER | FREELANCER | TECH_PRO | ENTHUSIAST
  interestCategory    String? // AI_RECEPTIONIST | AI_SALES | AI_DEVELOPMENT | AI_AUTOMATION | GENERAL_AI
  relevance           String    @default("LOW") // HIGH | MEDIUM | LOW | SPAM
  score               Int       @default(0)
  reason              String?   @db.Text // why this person was selected
  topic               String? // what they talked about, for personalisation
  icebreaker          String?   @db.Text // one line reacting to their comment (AI pass)
  bestCommentId       String?
  commentCount        Int       @default(0)
  status              String    @default("NEW")
  // NEW | RESEARCHING | PROFILE_FOUND | EMAIL_FOUND | EMAIL_VERIFIED | READY_TO_CONTACT | NO_CONTACT
  // | IN_CAMPAIGN | INVALID_EMAIL | DO_NOT_CONTACT
  consentSensitive    Boolean   @default(false) // EU/UK/CA/AU/NZ: stricter outreach rules
  intentScore         Int       @default(0) // how likely they want to build/buy (0-100)
  intentEvidence      String[]  @default([]) // "Runs an agency", "Commented on 3 videos" …
  identityScore       Int       @default(0) // how sure we are who they are (0-100)
  ownChannelSummary   String? // "14 videos, mostly about n8n / AI agents"
  ownChannelAi        Boolean   @default(false) // their own uploads are about AI/automation
  deepReadAt          DateTime? // own channel + uploads read via the API
  webSearchedAt       DateTime? // identity search done
  finderCheckedAt     DateTime? // email-finder APIs asked
  aiCheckedAt         DateTime?
  enrichedAt          DateTime?
  enrichAttempts      Int       @default(0)
  enrichNotes         String?   @db.Text
  // Intelligence (PRD M3)
  useCase             String? // AI_RECEPTIONIST | VOICE_AGENT | AI_SALES_AGENT | … | UNKNOWN
  useCaseDetail       String?
  forWhom             String? // SELF | CLIENTS | EMPLOYER | UNKNOWN
  vertical            String?
  buildStage          String? // EXPLORING | BUILDING | SHIPPED | SELLING
  blocker             String?
  useCaseSource       String? // RULES | AI | MANUAL
  fitScore            Int       @default(0)
  fitReasons          String[]  @default([])
  reachability        Int       @default(0)
  opportunityScore    Int       @default(0)
  whyTriven           String?   @db.Text
  outreachAngle       String?   @db.Text
  aiCitations         Json?
  discoveryStage      String    @default("COLLECTED")
  inauthentic         Boolean   @default(false)
  lastEngagedAt       DateTime?
  // First-touch attribution (PRD R9.1)
  firstSourcePlatform String?
  firstContainerId    String?
  firstContentId      String?
  firstEngagementId   String?
  // Manual warm touch for high-fit people with no email (PRD R4.6)
  warmTouch           String? // TODO | TOUCHED | RESPONDED | SKIPPED
  warmTouchedAt       DateTime?
  firstSeenAt         DateTime  @default(now())
  lastSeenAt          DateTime  @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  comments AudienceComment[]
  emails   ProspectEmail[]
  evidence ProspectEvidence[]
  lead     Lead?

  @@index([relevance])
  @@index([opportunityScore])
  @@index([useCase])
  @@index([discoveryStage])
  @@index([status])
  @@index([score])
  @@index([interestCategory])
  @@index([persona])
  @@index([country])
  @@map("prospects")
}

// Several addresses per person; an address belongs to exactly one person
model ProspectEmail {
  id                String    @id @default(cuid())
  prospectId        String
  email             String    @unique
  source            String // CHANNEL | CHANNEL_VIDEO | COMMENT | WEBSITE | LINK_PAGE | HUNTER | APOLLO | PATTERN | MANUAL
  sourceUrl         String?
  confidence        Int? // finder / verifier confidence 0-100
  status            String    @default("UNKNOWN") // VERIFIED | RISKY | UNKNOWN | INVALID
  verifyMethod      String? // MX | ZEROBOUNCE | NEVERBOUNCE | MILLIONVERIFIER | REOON | BOUNCE
  verifyDetail      String?
  isPrimary         Boolean   @default(false)
  isRole            Boolean   @default(false)
  isFree            Boolean   @default(false)
  confidenceReasons String[]  @default([])
  checkedAt         DateTime?
  createdAt         DateTime  @default(now())

  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([prospectId])
  @@index([status])
  @@map("prospect_emails")
}

// ─────────────────────────────────────────────────────────────────────────────
// LEAD FINDER (local businesses: Google Places API / OpenStreetMap → website → email)
// ─────────────────────────────────────────────────────────────────────────────

// One search: a niche across one or more locations. Runs in pages, resumable across worker ticks
model LeadSearch {
  id          String    @id @default(cuid())
  query       String // what was searched ("dentist")
  niche       String? // niche id from the catalog (dental, medspa…); null = free text
  locations   String[]  @default([])
  country     String? // ISO-2 bias for Google / filter for OSM
  provider    String    @default("GOOGLE") // GOOGLE | OSM
  maxPerPlace Int       @default(60)
  status      String    @default("QUEUED") // QUEUED | RUNNING | DONE | ERROR | CANCELLED
  cursor      Json? // { loc: index of the next location, token: Google page token }
  found       Int       @default(0) // results returned
  added       Int       @default(0) // new businesses saved
  duplicates  Int       @default(0)
  filtered    Int       @default(0) // off-niche / closed / chains dropped
  apiCalls    Int       @default(0)
  lastError   String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  businesses Business[]

  @@index([createdAt])
  @@map("lead_searches")
}

model Business {
  id             String    @id @default(cuid())
  placeId        String    @unique // Google place id, or "osm:node/123"
  source         String    @default("GOOGLE") // GOOGLE | OSM | MANUAL
  searchId       String?
  name           String
  niche          String?
  category       String? // "Dentist", "Plumber"
  types          String[]  @default([])
  address        String?
  city           String?
  state          String?
  postalCode     String?
  country        String?
  lat            Float?
  lng            Float?
  phone          String?
  website        String?
  domain         String?
  mapsUrl        String?
  rating         Float?
  reviewCount    Int       @default(0)
  businessStatus String? // OPERATIONAL | CLOSED_TEMPORARILY | CLOSED_PERMANENTLY
  hours          String? // "Mon-Thu 8am-5pm, Fri-Sun closed"
  openDays       Int?
  closesAt       String? // usual weekday closing time "5pm"
  // Decision maker (from the website, JSON-LD or a LinkedIn search result title)
  ownerName      String?
  ownerTitle     String?
  ownerSource    String?
  linkedIn       String?
  facebook       String?
  instagram      String?
  contactFormUrl String?
  techSignals    String[]  @default([]) // "Online booking (NexHealth)", "Live chat (Podium)"
  siteFacts      String[]  @default([]) // "Accepting new patients", "Emergency appointments", "Since 1994"
  isChain        Boolean   @default(false)
  fitScore       Int       @default(0)
  fitReasons     String[]  @default([])
  tier           String    @default("COLD") // HOT | WARM | COLD
  status         String    @default("NEW")
  // NEW | RESEARCHING | READY | EMAIL_FOUND | NO_EMAIL | IN_CAMPAIGN | EXCLUDED | DO_NOT_CONTACT
  excludeReason  String?
  searchLog      String?   @db.Text // where we looked for an email, step by step
  enrichedAt     DateTime?
  enrichAttempts Int       @default(0)
  notes          String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  search LeadSearch?     @relation(fields: [searchId], references: [id], onDelete: SetNull)
  emails BusinessEmail[]
  lead   Lead?

  @@index([status])
  @@index([fitScore])
  @@index([niche])
  @@index([domain])
  @@index([searchId])
  @@map("businesses")
}

model BusinessEmail {
  id           String    @id @default(cuid())
  businessId   String
  email        String
  source       String // LISTING | WEBSITE | SEARCH | HUNTER | PATTERN | ROLE_GUESS | MANUAL
  sourceUrl    String?
  personName   String?
  position     String?
  confidence   Int?
  status       String    @default("UNKNOWN") // VERIFIED | RISKY | UNKNOWN | INVALID
  verifyMethod String?
  verifyDetail String?
  isRole       Boolean   @default(false)
  isFree       Boolean   @default(false)
  isPrimary    Boolean   @default(false)
  checkedAt    DateTime?
  createdAt    DateTime  @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, email])
  @@index([email])
  @@index([status])
  @@map("business_emails")
}

// ─────────────────────────────────────────────────────────────────────────────
// PRD v2: reliability, intelligence, segments, attribution
// ─────────────────────────────────────────────────────────────────────────────

// One row per worker call: the heartbeat behind System Health
model WorkerRun {
  id         String   @id @default(cuid())
  action     String // tick | audience | finder | nightly
  source     String? // scheduler that called it (header / user agent)
  startedAt  DateTime @default(now())
  durationMs Int      @default(0)
  ok         Boolean  @default(true)
  summary    Json?
  error      String?  @db.Text

  @@index([action, startedAt])
  @@map("worker_runs")
}

// Why we think what we think about a person: every score cites these
model ProspectEvidence {
  id         String    @id @default(cuid())
  prospectId String
  type       String // SELF_BUILDING | FOR_CLIENTS | OWNS_BUSINESS | ASKED_HOW_TO | NAMED_TOOL | NAMED_BLOCKER | REPEAT_ENGAGEMENT | OWN_AI_CONTENT | SITE_OFFERS_AI | JOB_TITLE | BUDGET_SIGNAL | NEGATIVE
  weight     Int       @default(0)
  text       String
  sourceUrl  String?
  sourceKind String // COMMENT | OWN_VIDEO | WEBSITE | PROFILE | SEARCH | FINDER | MANUAL
  observedAt DateTime?
  createdBy  String    @default("RULES") // RULES | AI | MANUAL
  createdAt  DateTime  @default(now())

  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([prospectId])
  @@index([type])
  @@map("prospect_evidence")
}

// Saved audience filter; can feed a campaign every day
model AudienceSegment {
  id         String    @id @default(cuid())
  name       String
  filters    Json
  campaignId String?
  autoFeed   Boolean   @default(false)
  dailyCap   Int       @default(30)
  lastRunAt  DateTime?
  lastCount  Int       @default(0)
  lastAdded  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("audience_segments")
}

// Nightly aggregate per source (our own numbers; survive raw-data purges)
model SourceSnapshot {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  platform    String
  containerId String // AudienceChannel.youtubeChannelId
  contentId   String   @default("") // AudienceVideo.youtubeVideoId, "" = channel total
  title       String?
  comments    Int      @default(0)
  flagged     Int      @default(0)
  people      Int      @default(0)
  qualified   Int      @default(0)
  qra         Int      @default(0)
  contacted   Int      @default(0)
  replied     Int      @default(0)
  positive    Int      @default(0)
  meetings    Int      @default(0)
  won         Int      @default(0)
  revenue     Float    @default(0)

  @@unique([date, containerId, contentId])
  @@index([containerId])
  @@map("source_snapshots")
}

// Never turn these into prospects (competitors, own staff, known engagement groups)
model ExclusionEntry {
  id        String   @id @default(cuid())
  kind      String // CHANNEL | DOMAIN | EMAIL | NAME
  value     String
  reason    String?
  createdAt DateTime @default(now())

  @@unique([kind, value])
  @@map("exclusions")
}
