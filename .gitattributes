# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Force LF for these types
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.prisma text eol=lf

# Binary files
*.png  binary
*.jpg  binary
*.ico  binary
